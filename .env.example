DP_APP_NAME=Discount Parser API
DP_ENV=local
DP_DEBUG=false
DP_HOST=127.0.0.1
DP_PORT=8000
DP_WEB_PORT=8765
DP_LOG_LEVEL=INFO
DP_LOG_FORMAT=plain
DP_TIMEZONE=Europe/Moscow
DP_DATABASE_URL=sqlite:///./discount_parser.db
DP_SOURCES_CONFIG_PATH=config/sources.yaml
DP_COLLECT_INTERVAL_MINUTES=120
DP_MAINTENANCE_HOUR=22
DP_MAINTENANCE_MINUTE=0
DP_STALE_AFTER_DAYS=7
DP_TELEGRAM_BOT_TOKEN=
DP_TELEGRAM_BOT_NAME=
DP_TELEGRAM_CHANNEL_ID=
DP_TELEGRAM_ADMIN_IDS=
DP_TELEGRAM_DEFAULT_MIN_DISCOUNT=20
DP_AUTOPOST_INTERVAL_MINUTES=30

# Optional collection integrations. These are separate from the publishing bot.
# Public Telegram channels can use telegram_public without MTProto credentials.
DP_TELEGRAM_COLLECTOR_API_ID=
DP_TELEGRAM_COLLECTOR_API_HASH=
DP_TELEGRAM_COLLECTOR_SESSION=
DP_VK_ACCESS_TOKEN=
DP_VK_API_VERSION=5.199

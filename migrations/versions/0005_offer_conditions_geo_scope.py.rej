+def _check_constraints(bind, table_name: str) -> set[str]:
+    inspector = sa.inspect(bind)
+    if table_name not in inspector.get_table_names():
+        return set()
+    return {
+        str(item["name"])
+        for item in inspector.get_check_constraints(table_name)
+        if item.get("name")
+    }
+
+
 def upgrade() -> None:
